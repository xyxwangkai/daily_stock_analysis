{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Web API (8001)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--serve-only", "--host", "0.0.0.0", "--port", "8001"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "python": "/usr/bin/python",
      "justMyCode": true,
      "subProcess": true
    }
  ]
}